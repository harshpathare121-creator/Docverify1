# Render environment variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Optional: use a verified sender/domain once configured in Resend.
# For initial testing, Resend supports onboarding@resend.dev in its documented onboarding flow.
RESEND_FROM=ConnectID <onboarding@resend.dev>
# If RESEND_API_KEY is absent, the app falls back to demo OTP mode.
EMAIL_MODE=demo
OTP_TTL_MINUTES=10
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
