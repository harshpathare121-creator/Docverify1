NODE_ENV=development
PORT=10000
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data

# auto = use Resend when RESEND_API_KEY is present, otherwise use demo OTPs
# demo = never send real email
EMAIL_MODE=auto
OTP_TTL_MINUTES=10

# Keep the API key out of GitHub.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=ConnectID <onboarding@resend.dev>

# Optional: restrict browser CORS to your deployed origin
# PUBLIC_ORIGIN=https://your-service.onrender.com
